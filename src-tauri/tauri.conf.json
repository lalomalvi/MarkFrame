{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkFrame",
  "version": "1.0.0",
  "identifier": "com.lalomalvi.markframe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MarkFrame",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "MarkFrame.nota",
        "description": "Nota Markdown",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "publisher": "Luis Eduardo Martinez Villasenor",
    "copyright": "Uso personal",
    "shortDescription": "Editor y lector de Markdown",
    "longDescription": "Abre cualquier archivo .md de cualquier carpeta y lo edita. Dos paneles, autoguardado, tablas, diagramas y formulas.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Spanish",
          "English"
        ]
      }
    }
  }
}